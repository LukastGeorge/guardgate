# Copy file này thành .env rồi điền giá trị thật:  cp .env.example .env
# .env đã nằm trong .gitignore -> KHÔNG BAO GIỜ commit secret.
# Sinh mật khẩu ngẫu nhiên:  openssl rand -base64 32

# --- PostgreSQL (superuser, chỉ dùng để init/quản trị) ---
POSTGRES_ADMIN_USER=guardgate_admin
POSTGRES_ADMIN_PASSWORD=change-me-admin-password
POSTGRES_PORT=5432

# --- Database riêng của auth-service (least privilege) ---
AUTH_DB_NAME=guardgate_auth
AUTH_DB_USER=auth_service
AUTH_DB_PASSWORD=change-me-auth-password

# --- Redis (rate limiting, token blacklist) ---
REDIS_PASSWORD=change-me-redis-password
REDIS_PORT=6379

# --- Port của các service (chạy local) ---
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
DEMO_SERVICE_PORT=8082
